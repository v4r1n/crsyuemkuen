# Copy to .env.local. Secrets stay local / Vercel server environment, never chat or Git.
# PostgreSQL connection string from Connect -> Transaction pooler (postgresql://...),
# NOT the https:// project URL used by SUPABASE_URL. Copy the exact host/user/port.
DATABASE_URL=
# Supabase pooler transaction URL, TLS verified; use DATABASE_CA if a private CA is needed.
DATABASE_CA=
SUPABASE_URL=
# Preferred server-only sb_secret_ key. Never use a publishable key here.
SUPABASE_SECRET_KEY=
# Optional legacy fallback for existing service_role JWT deployments.
SUPABASE_SERVICE_ROLE_KEY=
IMAGE_BUCKET=crs-images
WEB_APP_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
ALLOWED_DOMAINS=
AUTH_FLOW_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=21600
MAX_IMAGE_BYTES=4194304
# Freeze only mutations; reads/sign-in remain available. Enable during backup/cutover.
WRITE_FREEZE=false

# New additive identity/experience migration is required BEFORE deploying this source.
# OTP HMAC key: generate at least 32 random bytes; distinct from OAuth/SMTP secrets.
PASSWORD_OTP_SECRET=
# SMTP must use verified TLS (465 implicit TLS or 587 required STARTTLS).
# Never put these in NEXT_PUBLIC_* or browser configuration. Logging is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Plain authorized sender address, not a display-name/header string.
SMTP_FROM=
# reCAPTCHA v3: rotate any chat-exposed key pair before activation. No bypass flag.
# Public site key is delivered by /api/auth/recaptcha, secret stays server-only.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_LOGIN_ACTION=password_login
RECAPTCHA_RESET_ACTION=password_reset
# Optional exact hostname; must match this target's WEB_APP_URL hostname.
# Configure distinct Preview/Production hostname allowances in Google's console.
RECAPTCHA_HOSTNAME=
# Footer destinations are the operator-approved Google Privacy/Terms pages.
# Vercel server-only WEB_APP_URL and callback must use distinct target origins:
# Production: https://crsyuemkuen.vercel.app (+ /auth/callback)
# Preview: https://crsyuemkuen-preview.vercel.app (+ /auth/callback)
